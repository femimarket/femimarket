# Kotlin/Native cinterop over the Rust ffi staticlib (libffi.a): the md_*
# (metadata), ae_* (audio) and db_* (SeaORM repo) C-ABI from ffi/src/capi.rs.
# The header is generated by build.sh (cbindgen) BESIDE this .def; the static
# lib's filename + per-target search path are passed as extraOpts from
# build.gradle.kts because device/sim .a live under different cargo triples.
package = ffi
headers = ffi.h
headerFilter = ffi.h
# kira/cpal's CoreAudio backend lives in the same staticlib.
linkerOpts = -framework AudioToolbox -framework CoreAudio -framework AVFoundation -framework CoreVideo -framework CoreMedia
