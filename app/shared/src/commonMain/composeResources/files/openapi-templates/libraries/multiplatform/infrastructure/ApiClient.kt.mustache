    protected suspend fun <T: Any?> multipartFormRequest(
        requestConfig: RequestConfig<T>,
        body: kotlin.collections.List<PartData>?,
        authNames: kotlin.collections.List<String>,
        textFields: kotlin.collections.Map<String, String>? = null,
        fileFields: kotlin.collections.Map<String, MultipartFileSource>? = null,
    ): HttpResponse {
        // If a webMain module registered a streaming hook (browser only),
        // dispatch to it instead of Ktor's default MultiPartFormDataContent
        // path (which Ktor's JS engine buffers into a Uint8Array — see
        // ktor-client-core/js/src/.../JsUtils.js.kt getBodyBytes). The hook
        // gets the flat text/file maps directly from the walker in
        // api.mustache so it can build a native browser FormData with each
        // MultipartFileSource.native Blob attached — fetch streams that to
        // the wire without buffering.
        val hook = MultipartStreamingHook.configure
        if (hook != null && fileFields != null && fileFields.isNotEmpty()) {
            requestConfig.updateForAuth<T>(authNames)
            val headers = requestConfig.headers
            return client.request {
                this.url {
                    this.takeFrom(URLBuilder(baseUrl))
                    appendPath(requestConfig.path.trimStart('/').split('/'))
                    requestConfig.query.forEach { query ->
                        query.value.forEach { value -> parameter(query.key, value) }
                    }
                }
                this.method = requestConfig.method.httpMethod
                headers.filter { header -> !UNSAFE_HEADERS.contains(header.key) }
                    .forEach { header -> this.header(header.key, header.value) }
                hook(this, textFields ?: emptyMap(), fileFields)
            }
        }
        return request(requestConfig, MultiPartFormDataContent(body ?: listOf()), authNames)
    }

    protected suspend fun <T: Any?> urlEncodedFormRequest(requestConfig: RequestConfig<T>, body: Parameters?, authNames: kotlin.collections.List<String>): HttpResponse {
        return request(requestConfig, FormDataContent(body ?: Parameters.Empty), authNames)
    }

    protected suspend fun <T: Any?> jsonRequest(requestConfig: RequestConfig<T>, body: Any? = null, authNames: kotlin.collections.List<String>): HttpResponse = request(requestConfig, body, authNames)

    protected suspend fun <T: Any?> request(requestConfig: RequestConfig<T>, body: Any? = null, authNames: kotlin.collections.List<String>): HttpResponse {
        requestConfig.updateForAuth<T>(authNames)
        val headers = requestConfig.headers

        return client.request {
            this.url {
                this.takeFrom(URLBuilder(baseUrl))
                appendPath(requestConfig.path.trimStart('/').split('/'))
                requestConfig.query.forEach { query ->
                    query.value.forEach { value ->
                        parameter(query.key, value)
                    }
                }
            }
            this.method = requestConfig.method.httpMethod
            headers.filter { header -> !UNSAFE_HEADERS.contains(header.key) }.forEach { header -> this.header(header.key, header.value) }
            if (requestConfig.method in listOf(RequestMethod.PUT, RequestMethod.POST, RequestMethod.PATCH, RequestMethod.DELETE)) {
                val contentType = (requestConfig.headers[HttpHeaders.ContentType]?.let { ContentType.parse(it) }
                    ?: ContentType.Application.Json)
                this.contentType(contentType)
                this.setBody(body)
            }
        }
    }

    private fun <T: Any?> RequestConfig<T>.updateForAuth(authNames: kotlin.collections.List<String>) {
        for (authName in authNames) {
            val auth = authentications?.get(authName) ?: throw Exception("Authentication undefined: $authName")
            auth.apply(query, headers)
        }
    }

    private fun URLBuilder.appendPath(components: kotlin.collections.List<String>): URLBuilder = apply {
        encodedPath = encodedPath.trimEnd('/') + components.joinToString("/", prefix = "/") { it.encodeURLQueryComponent() }
    }

    private val RequestMethod.httpMethod: HttpMethod
        get() = when (this) {
            RequestMethod.DELETE -> HttpMethod.Delete
            RequestMethod.GET -> HttpMethod.Get
            RequestMethod.HEAD -> HttpMethod.Head
            RequestMethod.PATCH -> HttpMethod.Patch
            RequestMethod.PUT -> HttpMethod.Put
            RequestMethod.POST -> HttpMethod.Post
            RequestMethod.OPTIONS -> HttpMethod.Options
        }
}

class MultipartFileSource(
    val filename: String,
    val provider: io.ktor.client.request.forms.InputProvider,
    /**
     * Platform-native reference to the underlying file bytes. On browser
     * targets (jsMain / wasmJsMain — sharing the webMain source set), set
     * this to an `org.w3c.files.Blob` (or `File`) so the streaming hook
     * registered by WebMultipartStreaming.kt can attach it to a native
     * browser `FormData` via `fetchOptions`, bypassing Ktor's Uint8Array
     * buffer. On JVM / iOS / native, leave as null — Ktor's default engine
     * streams the InputProvider directly.
     */
    val native: Any? = null,
) {
    val contentType: io.ktor.http.ContentType = io.ktor.http.ContentType.defaultForFilePath(filename)
}

/**
 * Runtime dispatch hook for browser-side streaming multipart uploads.
 *
 * The webMain-generated `WebMultipartStreaming.kt` populates
 * [MultipartStreamingHook.configure] via an `@EagerInitialization` top-level
 * property initializer, which Kotlin/JS runs at module load and preserves
 * from DCE. When [ApiClient.multipartFormRequest] runs on a browser target
 * it finds the hook non-null and delegates to it, handing the hook the
 * already-flattened text and file maps produced by the walker in
 * `api.mustache`.
 *
 * On JVM / iOS / native no code sets this hook, so it stays null and
 * `multipartFormRequest` falls through to the default `MultiPartFormDataContent`
 * path — those engines stream `InputProvider` correctly.
 */
object MultipartStreamingHook {
    var configure: (io.ktor.client.request.HttpRequestBuilder.(
        textFields: Map<String, String>,
        fileFields: Map<String, MultipartFileSource>,
    ) -> Unit)? = null
}
