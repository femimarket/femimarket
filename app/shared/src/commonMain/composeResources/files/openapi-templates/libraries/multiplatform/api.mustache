/**
 * Recursively appends a value as bracket-keyed multipart form fields,
 * matching the wire format expected by serde_qs on the rust server.
 *
 * `files` is the per-call registry the caller passes on multipart operations
 * whose server-side `x-form-file-fields` vendor extension is non-empty. At
 * each JSON leaf the walker checks whether the leaf's *string value* is a
 * key in this map. If yes, it emits a streaming `FormPart` carrying the
 * matching `MultipartFileSource.provider` — bytes flow lazily through Ktor
 * during the upload. If no (or `files` is null), the leaf is appended as
 * plain text exactly as before, so non-file leaves and operations without a
 * registry are unaffected.
 *
 * Matching by leaf string value (typically a filename) lets nested file
 * leaves like `upsert[data][0][audio]` work without surfacing per-field
 * routing in the signature — the model field stays `String` (filename), the
 * caller hands in `mapOf("audio.mp3" to MultipartFileSource(...))`, and the
 * walker reconnects them at upload time.
 */
private inline fun <reified T : Any> FormBuilder.appendBracket(
    baseName: String,
    value: T,
    files: Map<String, MultipartFileSource>? = null,
    textFieldsOut: MutableMap<String, String>? = null,
    fileFieldsOut: MutableMap<String, MultipartFileSource>? = null,
) {
    appendBracketWalk(baseName, Json.Default.encodeToJsonElement(value), files, textFieldsOut, fileFieldsOut)
}

/**
 * Walks the JSON tree emitting Ktor `FormPart`s (default engine path). While
 * walking it also mirrors each leaf into flat text/file maps if the caller
 * passed writable ones — those flat maps are what
 * [MultipartStreamingHook.configure] consumes on browser targets to build a
 * native `FormData` and stream via `fetchOptions`. Non-browser targets ignore
 * the flat maps; Ktor's default engine handles the `FormPart` output directly.
 */
private fun FormBuilder.appendBracketWalk(
    prefix: String,
    el: JsonElement,
    files: Map<String, MultipartFileSource>?,
    textFieldsOut: MutableMap<String, String>?,
    fileFieldsOut: MutableMap<String, MultipartFileSource>?,
) {
    when (el) {
        is JsonNull -> return
        is JsonPrimitive -> {
            val src = files?.get(el.content)
            if (src != null) {
                append(
                    FormPart(
                        prefix,
                        src.provider,
                        Headers.build {
                            append(
                                HttpHeaders.ContentDisposition,
                                "form-data; name=\"$prefix\"; filename=\"${src.filename}\"",
                            )
                            append(HttpHeaders.ContentType, src.contentType.toString())
                        },
                    ),
                )
                fileFieldsOut?.put(prefix, src)
            } else {
                append(prefix, el.content)
                textFieldsOut?.put(prefix, el.content)
            }
        }
        is JsonArray -> el.forEachIndexed { i, v -> appendBracketWalk("$prefix[$i]", v, files, textFieldsOut, fileFieldsOut) }
        is JsonObject -> el.forEach { (k, v) -> appendBracketWalk("$prefix[$k]", v, files, textFieldsOut, fileFieldsOut) }
    }
}

